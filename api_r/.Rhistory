print(grafico_barras_horizontal)
grid.arrange(grafico_barras_artilheiros, grafico_barras_horizontal, ncol = 2)
clear
# Instalar pacotes, se necessário
install.packages(c("ggplot2", "dplyr", "forcats", "scales"))
# Carregar bibliotecas
library(ggplot2)
library(dplyr)
library(forcats)
library(scales)
# 1) Dataframe com os dados da imagem
serie_a_2023 <- data.frame(
clube = c(
"Flamengo", "Palmeiras", "Corinthians", "Athletico-PR", "São Paulo",
"Atlético-MG", "Fluminense", "Grêmio", "Fortaleza", "América-MG",
"Santos", "Bragantino", "Internacional", "Botafogo", "Coritiba",
"Vasco", "Bahia", "Cuiabá", "Goiás", "Cruzeiro"
),
gols_elenco = c(
501, 383, 331, 330, 249,
231, 210, 201, 194, 166,
151, 143, 135, 110, 90,
81, 73, 65, 65, 47
),
artilheiro = c(
"Gabriel", "Dudu", "Paulinho e Róger Guedes", "Pablo", "Luciano",
"Hulk", "Cano", "Diego Souza", "Yago Pikachu", "Juninho",
"Marcos Leonardo", "Alerrandro", "Alan Patrick", "Tiquinho Soares", "Alef Manga",
"Gabriel Pec", "Vitor Jacaré", "Deyverson", "Apodi e Vinícius", "Bruno Rodrigues"
),
gols_artilheiro = c(
149, 87, 40, 58, 58,
85, 68, 87, 36, 25,
42, 25, 22, 23, 27,
20, 12, 13, 13, 11
)
)
# 2) Variáveis auxiliares para destaque
serie_a_2023 <- serie_a_2023 %>%
mutate(
destaque = ifelse(clube == "Flamengo", "Flamengo", "Demais clubes"),
percentual_artilheiro = gols_artilheiro / gols_elenco
)
# 3) Medidas estatísticas descritivas
media_gols <- mean(serie_a_2023$gols_elenco)
mediana_gols <- median(serie_a_2023$gols_elenco)
desvio_padrao_gols <- sd(serie_a_2023$gols_elenco)
cat("Média de gols dos elencos:", round(media_gols, 1), "\n")
cat("Mediana de gols dos elencos:", round(mediana_gols, 1), "\n")
cat("Desvio-padrão:", round(desvio_padrao_gols, 1), "\n")
# 4) Gráfico principal: gols por elenco
grafico_gols_elenco <- ggplot(
serie_a_2023 %>% arrange(gols_elenco),
aes(x = fct_reorder(clube, gols_elenco), y = gols_elenco, fill = destaque)
) +
geom_col(width = 0.72) +
coord_flip() +
geom_hline(yintercept = media_gols, linetype = "dashed", linewidth = 0.8, color = "gray35") +
geom_text(aes(label = gols_elenco), hjust = -0.15, size = 3.6) +
annotate(
"text",
x = 2,
y = media_gols + 12,
label = paste0("Média = ", round(media_gols, 1)),
color = "gray30",
size = 3.6,
hjust = 0
) +
scale_fill_manual(values = c("Flamengo" = "#C1121F", "Demais clubes" = "#BFC0C0")) +
scale_y_continuous(expand = expansion(mult = c(0, 0.08))) +
labs(
title = "Gols por elenco da Série A 2023",
subtitle = "O Flamengo se destaca como o elenco com maior produção ofensiva",
x = NULL,
y = "Número de gols",
fill = NULL,
caption = "Fonte: dados organizados a partir da tabela da matéria"
) +
theme_minimal(base_size = 12) +
theme(
legend.position = "top",
panel.grid.major.y = element_blank(),
panel.grid.minor = element_blank(),
plot.title = element_text(face = "bold"),
plot.subtitle = element_text(color = "gray30")
)
print(grafico_gols_elenco)
# 5) Gráfico no lugar do pizza: gols dos artilheiros de cada clube
grafico_artilheiros <- ggplot(
serie_a_2023 %>% arrange(gols_artilheiro),
aes(x = fct_reorder(clube, gols_artilheiro), y = gols_artilheiro, fill = destaque)
) +
geom_col(width = 0.72) +
coord_flip() +
geom_text(aes(label = gols_artilheiro), hjust = -0.15, size = 3.6) +
scale_fill_manual(values = c("Flamengo" = "#C1121F", "Demais clubes" = "#D9D9D9")) +
scale_y_continuous(expand = expansion(mult = c(0, 0.08))) +
labs(
title = "Gols do principal artilheiro de cada elenco",
subtitle = "Gráfico de barras substitui o pizza e melhora a comparação entre clubes",
x = NULL,
y = "Gols do artilheiro",
fill = NULL,
caption = "Fonte: dados organizados a partir da tabela da matéria"
) +
theme_minimal(base_size = 12) +
theme(
legend.position = "top",
panel.grid.major.y = element_blank(),
panel.grid.minor = element_blank(),
plot.title = element_text(face = "bold"),
plot.subtitle = element_text(color = "gray30")
)
print(grafico_artilheiros)
# 6) Gráfico estatisticamente mais interessante:
# participação do artilheiro no total de gols do elenco
grafico_percentual <- ggplot(
serie_a_2023 %>% arrange(percentual_artilheiro),
aes(x = fct_reorder(clube, percentual_artilheiro), y = percentual_artilheiro, fill = destaque)
) +
geom_col(width = 0.72) +
coord_flip() +
geom_text(aes(label = percent(percentual_artilheiro, accuracy = 0.1)),
hjust = -0.15, size = 3.5) +
scale_fill_manual(values = c("Flamengo" = "#C1121F", "Demais clubes" = "#CED4DA")) +
scale_y_continuous(
labels = percent_format(accuracy = 1),
expand = expansion(mult = c(0, 0.10))
) +
labs(
title = "Participação do artilheiro nos gols do elenco",
subtitle = "Esse indicador mostra a dependência ofensiva de cada time em relação ao seu principal goleador",
x = NULL,
y = "Participação do artilheiro no total de gols",
fill = NULL,
caption = "Fonte: cálculo próprio a partir dos dados da tabela"
) +
theme_minimal(base_size = 12) +
theme(
legend.position = "top",
panel.grid.major.y = element_blank(),
panel.grid.minor = element_blank(),
plot.title = element_text(face = "bold"),
plot.subtitle = element_text(color = "gray30")
)
print(grafico_percentual)
# =========================================================
# REFAZENDO OS GRÁFICOS DO GE - FLAMENGO / SÉRIE A 2023
# Boas práticas: barras horizontais, ordenação, pouco ruído,
# destaque seletivo, legenda mínima e boa legibilidade
# =========================================================
# Pacotes
library(tidyverse)
install.packages(c("ggplot2", "dplyr", "tibble", "scales"))
# =========================================================
# REFAZENDO OS GRÁFICOS DO GE - FLAMENGO / SÉRIE A 2023
# Boas práticas: barras horizontais, ordenação, pouco ruído,
# destaque seletivo, legenda mínima e boa legibilidade
# =========================================================
# Pacotes
library(tidyverse)
clear
install.packages(c("ggplot2", "dplyr", "tibble", "scales"))
library(ggplot2)
library(dplyr)
library(tibble)
library(scales)
# Pacotes necessários
library(ggplot2)
library(dplyr)
library(tibble)
library(scales)
# =========================================================
# 1) DATA FRAMES
# =========================================================
jogadores <- tibble(
jogador = c(
"Gabriel", "Pedro", "Bruno Henrique", "Arrascaeta", "Everton Ribeiro",
"Gerson", "Matheus França", "Ayrton Lucas", "Léo Pereira", "Marinho",
"Rodrigo Caio", "Everton Cebolinha", "Fabrício Bruno", "Filipe Luís",
"Matheuzinho", "Thiago Maia", "Victor Hugo", "Matheus Gonçalves",
"Vidal", "André Luiz", "David Luiz", "Erick Pulgar", "Lorran",
"Werton", "Wesley"
),
gols = c(149, 93, 79, 55, 44, 10, 9, 8, 6, 6, 6, 5, 5, 4, 4, 4, 4, 2, 2, 1, 1, 1, 1, 1, 1)
)
serie_a <- tibble(
clube = c(
"Flamengo", "Palmeiras", "Corinthians", "Athletico-PR", "São Paulo",
"Atlético-MG", "Fluminense", "Grêmio", "Fortaleza", "América-MG",
"Santos", "Bragantino", "Internacional", "Botafogo", "Coritiba",
"Vasco", "Bahia", "Cuiabá", "Goiás", "Cruzeiro"
),
gols = c(501, 383, 331, 330, 249, 231, 210, 201, 194, 166, 151, 143, 135, 110, 90, 81, 73, 65, 65, 47),
artilheiro = c(
"Gabriel - 149", "Dudu - 87", "Paulinho e Róger Guedes - 40", "Pablo - 58",
"Luciano - 58", "Hulk - 85", "Cano - 68", "Diego Souza - 87",
"Yago Pikachu - 36", "Juninho - 25", "Marcos Leonardo - 42",
"Alerrandro - 25", "Alan Patrick - 22", "Tiquinho Soares - 23",
"Alef Manga - 27", "Gabriel Pec - 20", "Vitor Jacaré - 12",
"Deyverson - 13", "Apodi e Vinícius - 13", "Bruno Rodrigues - 11"
)
)
adversarios <- tibble(
adversario = c(
"Athletico-PR", "Vasco", "Fluminense", "Bahia", "Corinthians",
"Goiás", "Botafogo", "Palmeiras", "Grêmio", "Santos"
),
gols_sofridos = c(29, 28, 27, 17, 17, 17, 16, 16, 15, 15)
)
# =========================================================
# 2) PREPARAÇÃO DOS DADOS
# =========================================================
jogadores_plot <- jogadores %>%
arrange(gols) %>%
mutate(
jogador = factor(jogador, levels = jogador),
destaque = case_when(
jogador %in% c("Gabriel", "Pedro", "Bruno Henrique", "Arrascaeta", "Everton Ribeiro") ~ "Top 5",
TRUE ~ "Demais atletas"
)
)
serie_a_plot <- serie_a %>%
arrange(gols) %>%
mutate(
clube = factor(clube, levels = clube),
destaque = if_else(clube == "Flamengo", "Flamengo", "Outros clubes")
)
adversarios_plot <- adversarios %>%
arrange(gols_sofridos) %>%
mutate(adversario = factor(adversario, levels = adversario))
tema_base <- theme_minimal(base_size = 13) +
theme(
plot.title = element_text(face = "bold", size = 16),
plot.subtitle = element_text(size = 11),
axis.title.y = element_blank(),
panel.grid.major.y = element_blank(),
panel.grid.minor = element_blank(),
legend.position = "top"
)
# =========================================================
# 3) GRÁFICO 1 - JOGADORES
# =========================================================
grafico_jogadores <- ggplot(jogadores_plot, aes(x = jogador, y = gols, fill = destaque)) +
geom_col(width = 0.75) +
geom_text(aes(label = gols), hjust = -0.15, size = 3.5) +
coord_flip(clip = "off") +
scale_y_continuous(expand = expansion(mult = c(0, 0.08))) +
scale_fill_manual(values = c("Top 5" = "#C62828", "Demais atletas" = "#B0BEC5")) +
labs(
title = "Gols do elenco atual do Flamengo",
subtitle = "Comparação entre os jogadores do elenco",
x = NULL,
y = "Número de gols",
fill = NULL
) +
tema_base
# =========================================================
# 4) GRÁFICO 2 - SÉRIE A
# =========================================================
grafico_serie_a <- ggplot(serie_a_plot, aes(x = clube, y = gols, fill = destaque)) +
geom_col(width = 0.75) +
geom_text(aes(label = gols), hjust = -0.15, size = 3.5) +
coord_flip(clip = "off") +
scale_y_continuous(expand = expansion(mult = c(0, 0.08))) +
scale_fill_manual(values = c("Flamengo" = "#C62828", "Outros clubes" = "#CFD8DC")) +
labs(
title = "Gols de cada elenco da Série A 2023",
subtitle = "Flamengo em destaque",
x = NULL,
y = "Número de gols",
fill = NULL
) +
tema_base
# =========================================================
# 5) GRÁFICO 3 - ADVERSÁRIOS
# =========================================================
grafico_adversarios <- ggplot(adversarios_plot, aes(x = adversario, y = gols_sofridos)) +
geom_col(fill = "#263238", width = 0.75) +
geom_text(aes(label = gols_sofridos), hjust = -0.15, size = 3.5) +
coord_flip(clip = "off") +
scale_y_continuous(expand = expansion(mult = c(0, 0.08))) +
labs(
title = "Top 10 adversários que mais sofreram gols do elenco atual do Flamengo",
subtitle = "Ranking dos clubes que mais levaram gols",
x = NULL,
y = "Gols sofridos"
) +
tema_base
# Exibir os gráficos
grafico_jogadores
grafico_serie_a
grafico_adversarios
# =========================================================
# 5) GRÁFICO 3 - ADVERSÁRIOS
# =========================================================
adversarios_plot <- adversarios %>%
arrange(gols_sofridos) %>%
mutate(
adversario = factor(adversario, levels = adversario),
destaque = if_else(adversario == "Athletico-PR", "Athletico-PR", "Outros")
)
grafico_adversarios <- ggplot(adversarios_plot, aes(x = adversario, y = gols_sofridos, fill = destaque)) +
geom_col(width = 0.75) +
geom_text(aes(label = gols_sofridos), hjust = -0.15, size = 3.5) +
coord_flip(clip = "off") +
scale_y_continuous(expand = expansion(mult = c(0, 0.08))) +
scale_fill_manual(values = c("Athletico-PR" = "#C62828", "Outros" = "#B0BEC5")) +
labs(
title = "Top 10 adversários que mais sofreram gols do elenco atual do Flamengo",
subtitle = "Athletico-PR em destaque por ser o time que mais sofreu gols",
x = NULL,
y = "Gols sofridos",
fill = NULL
) +
tema_base
grafico_adversarios
