# Pacotes
library(rpart)
library(rpart.plot)
library(caret)
# Dados
data(neo4j_File)
# Separação treino/teste
set.seed(2)
indice_treino <- createDataPartition(
y = neo4j_File$`Number of committers`,
p = 0.7,
list = FALSE
)
treino <- neo4j_File[indice_treino, ]
teste  <- neo4j_File[-indice_treino, ]
# Treinamento
modelo_tree <- rpart(
`Number of committers` ~ `Number of developer commits`,
data = treino,
method = "anova"
)
# Visualização
rpart.plot(
modelo_tree,
type = 2,
extra = 101,
fallen.leaves = TRUE
)
# Previsão
pred_tree <- predict(
modelo_tree,
teste
)
# Avaliação
postResample(
pred = pred_tree,
obs = teste$`Number of committers`
)
