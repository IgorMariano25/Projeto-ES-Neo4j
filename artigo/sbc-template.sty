\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sbc-template}[2023/01/01 SBC Template]

\RequirePackage{times}
\RequirePackage[T1]{fontenc}

% Page layout
\setlength{\textheight}{235mm}
\setlength{\topmargin}{-10mm}
\setlength{\textwidth}{165mm}
\setlength{\oddsidemargin}{-2mm}
\setlength{\evensidemargin}{-2mm}
\setlength{\columnsep}{8mm}

% Paragraph
\setlength{\parindent}{1.27cm}
\setlength{\parskip}{6pt}

% Sections
\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {-12pt plus -2pt minus -2pt}{6pt plus 2pt minus 2pt}%
  {\normalfont\large\bfseries}}

\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {-12pt plus -2pt minus -2pt}{6pt plus 2pt minus 2pt}%
  {\normalfont\normalsize\bfseries}}

% Abstract environment (SBC: 12pt Times, 0.8cm indent both sides)
\renewenvironment{abstract}%
  {\begin{center}\fontsize{12}{14}\selectfont\textbf{Abstract.}\end{center}%
   \list{}{\leftmargin 0.8cm \rightmargin 0.8cm}\item\relax\fontsize{12}{14}\selectfont}%
  {\endlist}

% Resumo environment (SBC: 12pt Times, 0.8cm indent both sides)
\newenvironment{resumo}%
  {\begin{center}\fontsize{12}{14}\selectfont\textbf{Resumo.}\end{center}%
   \list{}{\leftmargin 0.8cm \rightmargin 0.8cm}\item\relax\fontsize{12}{14}\selectfont}%
  {\endlist}

% Address
\newcommand{\address}[1]{\gdef\@address{#1}}
\newcommand{\inst}[1]{\unskip$^{#1}$}
\newcommand{\nextinstitute}{\par}
\newcommand{\email}[1]{\par\texttt{#1}}

% Redefine maketitle
\def\@maketitle{%
  \newpage
  \null
  \begin{center}%
    {\LARGE\bfseries \@title \par}%
    \vskip 12pt%
    {\large \@author \par}%
    \vskip 6pt%
    {\normalsize \@address \par}%
  \end{center}%
  \par
  \vskip 12pt}

% Bibliography (SBC: 12pt, 6pt space before each entry, 0.5cm hanging indent)
\renewenvironment{thebibliography}[1]{%
  \section*{\refname}%
  \fontsize{12}{14}\selectfont
  \list{}{%
    \setlength{\labelwidth}{0pt}%
    \setlength{\labelsep}{0pt}%
    \setlength{\leftmargin}{0.5cm}%
    \setlength{\itemindent}{-0.5cm}%
    \setlength{\itemsep}{6pt}%
    \setlength{\parsep}{0pt}%
    \setlength{\topsep}{6pt}%
  }%
  \sloppy\clubpenalty4000\widowpenalty4000%
  \sfcode`\.=\@m}%
  {\endlist}

\endinput
