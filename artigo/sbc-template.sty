\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sbc-template}[2023/01/01 SBC Template]

\RequirePackage{times}
\RequirePackage[T1]{fontenc}

% Page layout
\setlength{\textheight}{235mm}
\setlength{\topmargin}{-10mm}
\setlength{\textwidth}{165mm}
\setlength{\oddsidemargin}{-2mm}
\setlength{\evensidemargin}{-2mm}
\setlength{\columnsep}{8mm}

% Paragraph
\setlength{\parindent}{1.27cm}
\setlength{\parskip}{6pt}

% Sections
\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {-12pt plus -2pt minus -2pt}{6pt plus 2pt minus 2pt}%
  {\normalfont\large\bfseries}}

\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {-12pt plus -2pt minus -2pt}{6pt plus 2pt minus 2pt}%
  {\normalfont\normalsize\bfseries}}

% Abstract environment
\renewenvironment{abstract}%
  {\begin{center}\small\textbf{Abstract.}\end{center}\begin{quotation}\small}%
  {\end{quotation}}

% Resumo environment
\newenvironment{resumo}%
  {\begin{center}\small\textbf{Resumo.}\end{center}\begin{quotation}\small}%
  {\end{quotation}}

% Address
\newcommand{\address}[1]{\gdef\@address{#1}}
\newcommand{\inst}[1]{\unskip$^{#1}$}
\newcommand{\nextinstitute}{\par}
\newcommand{\email}[1]{\par\texttt{#1}}

% Redefine maketitle
\def\@maketitle{%
  \newpage
  \null
  \begin{center}%
    {\LARGE\bfseries \@title \par}%
    \vskip 12pt%
    {\large \@author \par}%
    \vskip 6pt%
    {\normalsize \@address \par}%
  \end{center}%
  \par
  \vskip 12pt}

\endinput
